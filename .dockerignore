# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Ignore virtual environments
venv/
.venv/
env/

# Ignore git
.git/
.gitignore
.gitattributes

# Ignore IDE/editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore test and development files
tests/
*.md
!README.md
demo/
*.log

# Ignore wheels (not needed in container, installed via pip)
wheels/

# Ignore screenshots (documentation only)
screenshots/
